---
import { Image } from "astro:assets";
import authorConfig from "@config/siteConfig/info.json";
import {
	ArrowRight,
	Briefcase,
	MessageCircle,
	Send,
} from "lucide-react";
import { FaGithub, FaLinkedin, FaYoutube } from "react-icons/fa6";

const {
	name,
	jobTitle,
	position,
	picture,
	tag_line,
	socialLinks,
	stats,
	about,
	coreStack,
	services,
} = authorConfig;

const linkedinUrl = `https://www.linkedin.com/in/${socialLinks.linkedin}`;
const whatsappUrl = `https://wa.me/${socialLinks.whatsNumber}?text=Hello%20there!`;

const storySections = [
	{
		index: "01",
		title: "The Engineer",
		text: `${about.whoAmI.split(". ").slice(0, 2).join(". ")}.`,
		color: "#7aa2f7",
	},
	{
		index: "02",
		title: "Beyond the Screen",
		text: `${about.lifeBeyondCode.split(". ").slice(0, 2).join(". ")}.`,
		color: "#bb9af7",
	},
	{
		index: "03",
		title: "Always Learning",
		text: `${about.continuousLearning.split(". ").slice(0, 2).join(". ")}.`,
		color: "#9ece6a",
	},
];
---

<style>
  .fade-up {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease-out forwards;
  }
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .delay-1 { animation-delay: 0.1s; }
  .delay-2 { animation-delay: 0.2s; }
  .delay-3 { animation-delay: 0.3s; }
  .delay-4 { animation-delay: 0.4s; }
</style>

<!-- ============================================================
     Section 1: Hero — Split Layout
     ============================================================ -->
<section class="relative bg-[#1a1b26] px-4 pb-12 pt-24 sm:px-8 sm:pb-16 sm:pt-32 lg:px-12">
  <div class="mx-auto max-w-6xl">
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
      <!-- Left: Photo -->
      <div class="fade-up flex justify-center lg:justify-start">
        <Image
          src={picture}
          alt={name}
          width={320}
          height={320}
          class="h-56 w-56 rounded-3xl object-cover ring-2 ring-[#7aa2f7]/20 sm:h-72 sm:w-72 lg:h-80 lg:w-80"
          loading="eager"
        />
      </div>

      <!-- Right: Text -->
      <div class="text-center lg:text-left">
        <p class="fade-up delay-1 mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#7aa2f7]">
          {jobTitle}
        </p>
        <h1
          class="fade-up delay-1 mb-3 bg-gradient-to-r from-[#7aa2f7] via-[#bb9af7] to-[#7aa2f7] bg-clip-text font-black text-transparent"
          style="font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1.1;"
        >
          {name}
        </h1>
        <p class="fade-up delay-2 mb-2 text-lg font-medium text-[#a9b1d6] sm:text-xl">
          {position}
        </p>
        <p class="fade-up delay-3 mx-auto mb-6 max-w-md text-[#565f89] lg:mx-0" style="font-size: clamp(0.875rem, 1.2vw, 1rem);">
          {tag_line}
        </p>

        <!-- Social icons -->
        <div class="fade-up delay-3 mb-8 flex items-center justify-center gap-1 lg:justify-start">
          <a href={socialLinks.github} target="_blank" rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-lg text-[#565f89] transition-colors duration-200 hover:text-[#c0caf5]"
            aria-label="GitHub">
            <FaGithub className="h-[18px] w-[18px]" />
          </a>
          <a href={linkedinUrl} target="_blank" rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-lg text-[#565f89] transition-colors duration-200 hover:text-[#7aa2f7]"
            aria-label="LinkedIn">
            <FaLinkedin className="h-[18px] w-[18px]" />
          </a>
          <a href={socialLinks.twitter} target="_blank" rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-lg text-[#565f89] transition-colors duration-200 hover:text-[#bb9af7]"
            aria-label="Twitter">
            <Send className="h-[18px] w-[18px]" />
          </a>
          <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-lg text-[#565f89] transition-colors duration-200 hover:text-[#9ece6a]"
            aria-label="YouTube">
            <FaYoutube className="h-[18px] w-[18px]" />
          </a>
          <a href={socialLinks.upwork} target="_blank" rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-lg text-[#565f89] transition-colors duration-200 hover:text-[#7aa2f7]"
            aria-label="Upwork">
            <Briefcase className="h-[18px] w-[18px]" />
          </a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-lg text-[#565f89] transition-colors duration-200 hover:text-[#9ece6a]"
            aria-label="WhatsApp">
            <MessageCircle className="h-[18px] w-[18px]" />
          </a>
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center justify-center gap-3 lg:justify-start">
          <a
            href="/contact-me"
            class="group inline-flex items-center gap-2 rounded-full bg-[#7aa2f7] px-7 py-3 text-sm font-semibold text-[#1a1b26] transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#89b4fa] active:translate-y-0"
          >
            Get in Touch
            <Send className="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" />
          </a>
          <a
            href="/project"
            class="inline-flex items-center gap-2 rounded-full border border-[#414868]/40 px-7 py-3 text-sm font-semibold text-[#a9b1d6] transition-colors duration-200 hover:border-[#565f89] hover:text-[#c0caf5]"
          >
            View My Work
            <ArrowRight className="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================
     Section 2: Stats Strip
     ============================================================ -->
<div class="border-y border-[#414868]/30 px-4 py-8 sm:px-8 sm:py-10">
  <div class="mx-auto grid max-w-6xl grid-cols-3 gap-4 sm:gap-0">
    {stats.map((stat) => (
      <div class="flex flex-col items-center border-r border-[#414868]/30 px-2 text-center last:border-r-0 sm:px-4">
        <div class="text-2xl font-black text-[#c0caf5] sm:text-4xl">
          {stat.value}
        </div>
        <div class="mt-1 text-[10px] uppercase tracking-wider text-[#565f89] sm:text-xs">
          {stat.label}
        </div>
      </div>
    ))}
  </div>
</div>

<!-- ============================================================
     Section 3: My Story — Numbered Editorial Sections
     ============================================================ -->
<section class="relative bg-[#1a1b26] px-4 py-14 sm:px-8 sm:py-20 lg:px-12">
  <div class="mx-auto max-w-3xl">
    <div class="mb-10 sm:mb-12">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#7aa2f7]">
        My Story
      </p>
      <h2
        style="font-size: clamp(1.875rem, 3.5vw, 3rem); line-height: 1.2;"
        class="font-bold text-[#c0caf5]"
      >
        The Person{" "}
        <span class="bg-gradient-to-r from-[#7aa2f7] to-[#bb9af7] bg-clip-text text-transparent">
          Behind the Code
        </span>
      </h2>
    </div>

    <div class="space-y-10">
      {storySections.map((section, index) => (
        <div
          class="fade-up border-t border-[#414868]/40 pt-6"
          style={`animation-delay: ${0.1 + index * 0.1}s;`}
        >
          <div class="mb-3 flex items-baseline gap-3">
            <span class="text-xs font-bold tracking-widest" style={`color: ${section.color};`}>
              {section.index}
            </span>
            <h3 class="text-lg font-bold text-[#c0caf5]">{section.title}</h3>
          </div>
          <p class="max-w-2xl text-sm leading-relaxed text-[#a9b1d6] sm:text-base">
            {section.text}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============================================================
     Section 4: Core Stack — Row Index
     ============================================================ -->
<section class="relative bg-[#1a1b26] px-4 py-14 sm:px-8 sm:py-20 lg:px-12">
  <div class="mx-auto max-w-5xl">
    <div class="mb-10 sm:mb-12">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#7aa2f7]">
        Tech Stack
      </p>
      <h2
        style="font-size: clamp(1.875rem, 3.5vw, 3rem); line-height: 1.2;"
        class="font-bold text-[#c0caf5]"
      >
        Core{" "}
        <span class="bg-gradient-to-r from-[#7aa2f7] to-[#bb9af7] bg-clip-text text-transparent">
          Technologies
        </span>
      </h2>
    </div>

    <div class="fade-up delay-1 grid grid-cols-1 gap-x-16 lg:grid-cols-2">
      {coreStack.map((tech) => (
        <div class="flex items-center justify-between gap-4 border-b border-[#414868]/40 py-3.5">
          <span class="flex items-center gap-3">
            <i
              class={`devicon-${tech.icon}-plain text-xl`}
              style={`color: ${tech.color};`}
            />
            <span class="text-sm font-medium text-[#c0caf5]">{tech.name}</span>
          </span>
          <span class="text-right text-xs text-[#565f89]">{tech.context}</span>
        </div>
      ))}
    </div>

    <div class="mt-10">
      <a
        href="/experience"
        class="inline-flex items-center gap-2 text-sm font-medium text-[#565f89] transition-colors duration-200 hover:text-[#7aa2f7]"
      >
        View full experience
        <ArrowRight className="h-4 w-4" />
      </a>
    </div>
  </div>
</section>

<!-- ============================================================
     Section 5: Services — Numbered Editorial Sections
     ============================================================ -->
<section class="relative bg-[#1a1b26] px-4 py-14 sm:px-8 sm:py-20 lg:px-12">
  <div class="mx-auto max-w-5xl">
    <div class="mb-10 sm:mb-12">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#7aa2f7]">
        What I Do
      </p>
      <h2
        style="font-size: clamp(1.875rem, 3.5vw, 3rem); line-height: 1.2;"
        class="font-bold text-[#c0caf5]"
      >
        Services I{" "}
        <span class="bg-gradient-to-r from-[#7aa2f7] to-[#bb9af7] bg-clip-text text-transparent">
          Offer
        </span>
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-x-16 gap-y-10 md:grid-cols-2">
      {services.map((service, index) => {
        const color = ["#7aa2f7", "#bb9af7", "#9ece6a", "#7aa2f7"][index]!;
        return (
          <div
            class="fade-up border-t border-[#414868]/40 pt-6"
            style={`animation-delay: ${index * 0.1}s;`}
          >
            <div class="mb-3 flex items-baseline gap-3">
              <span class="text-xs font-bold tracking-widest" style={`color: ${color};`}>
                0{index + 1}
              </span>
              <h3 class="text-lg font-bold text-[#c0caf5]">{service.title}</h3>
            </div>

            <p class="mb-4 text-sm leading-relaxed text-[#a9b1d6]">
              {service.description}
            </p>

            <ul class="mb-4 space-y-1.5">
              {service.features.slice(0, 4).map((feature: string) => (
                <li class="flex items-start gap-2 text-xs text-[#565f89]">
                  <span class="mt-0.5 text-[#9ece6a]">&#9657;</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <p class="text-xs leading-relaxed text-[#565f89]">
              {service.technologies.join(" &middot; ")}
            </p>
          </div>
        );
      })}
    </div>
  </div>
</section>

<!-- ============================================================
     Section 6: CTA — Full Width Closer
     ============================================================ -->
<section class="relative bg-[#1a1b26] px-4 py-16 sm:px-8 sm:py-24 lg:px-12">
  <div class="mx-auto max-w-3xl text-center">
    <p class="fade-up mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#7aa2f7]">
      Open to Opportunities
    </p>
    <h2
      style="font-size: clamp(1.875rem, 3.5vw, 2.5rem); line-height: 1.2;"
      class="fade-up delay-1 mb-8 font-bold text-[#c0caf5]"
    >
      Let's build something{" "}
      <span class="bg-gradient-to-r from-[#7aa2f7] to-[#bb9af7] bg-clip-text text-transparent">
        together
      </span>
    </h2>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/contact-me"
        class="group inline-flex items-center gap-2 rounded-full bg-[#7aa2f7] px-7 py-3 text-sm font-semibold text-[#1a1b26] transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#89b4fa] active:translate-y-0"
      >
        Get in Touch
        <Send className="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" />
      </a>
      <a
        href="/project"
        class="inline-flex items-center gap-2 rounded-full border border-[#414868]/40 px-7 py-3 text-sm font-semibold text-[#a9b1d6] transition-colors duration-200 hover:border-[#565f89] hover:text-[#c0caf5]"
      >
        View My Work
        <ArrowRight className="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
